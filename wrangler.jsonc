{
  // Static site plus a small API Worker.
  // Cloudflare runs `npm run build` (→ dist/) then `npx wrangler deploy`, which
  // uploads dist/ as static assets and worker/index.js as the script.
  "name": "vikendica-meri",
  "compatibility_date": "2025-06-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    // The Worker needs this to hand a request back to the asset router.
    "binding": "ASSETS",
    // Already the default, but pinned so a future Wrangler default cannot silently
    // change canonical URLs: serves /path/ from /path/index.html and 307s /path → /path/.
    "html_handling": "auto-trailing-slash",
    // Serve dist/404.html with a real 404 status. This is not an SPA — unknown
    // paths must not fall back to index.html.
    "not_found_handling": "404-page",
    // Load-bearing, not decoration. `not_found_handling: 404-page` makes the
    // asset router answer anything that is not a file with dist/404.html, which
    // would swallow /api/* before the Worker ever ran. Listing the paths here is
    // what guarantees they reach the script; everything else still hits assets
    // first and behaves exactly as it did before the Worker existed.
    "run_worker_first": ["/api/*", "/manager", "/manager/*", "/calendar.ics"]
  },
  // Workers Logs, plus request tracing. This Worker owns no AI agent, so the
  // agent-framework half of Cloudflare's tracing setup does not apply; what
  // traces buy here is visibility into the paths that fail silently by design
  // (Turnstile siteverify, the Web3Forms notification). No head_sampling_rate:
  // omitted means 100%, which is right at this traffic level.
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "vars": {
    // Public identifiers, not secrets: the Access team domain and the
    // Application Audience tag of the /manager application. Both come from the
    // Zero Trust dashboard. verifyAccess() refuses every admin request while
    // these are unset, so an unconfigured deploy fails closed.
    "ACCESS_TEAM_DOMAIN": "vikendica-meri.cloudflareaccess.com",
    "ACCESS_AUD": "592363ef1a0aa234113012a673e3d23542498e615ad0d98ff18c1d180f820450",
    // Web3Forms access key. A var and not a secret: Web3Forms publishes it as a
    // client-side value and it has been in this repo's history since the form
    // existed. What changed is that the *endpoint* is no longer callable without
    // passing Turnstile first, because only this Worker calls it now.
    "WEB3FORMS_KEY": "bc60fbf4-87e2-4fa8-bde9-b5636e7bca26"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vikendica-meri",
      "database_id": "8a52d365-2f5d-4901-b53a-ab340178902a"
    }
  ]
}
