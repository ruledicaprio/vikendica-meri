{
  // Static-assets-only Worker: serves the built ./dist as the site.
  // Cloudflare runs `npm run build` (→ dist/) then `npx wrangler deploy`,
  // which uploads dist/ as static assets. No server code needed.
  "name": "vikendica-meri",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./dist",
    // Already the default, but pinned so a future Wrangler default cannot silently
    // change canonical URLs: serves /path/ from /path/index.html and 307s /path → /path/.
    "html_handling": "auto-trailing-slash",
    // Serve dist/404.html with a real 404 status. This is not an SPA — unknown
    // paths must not fall back to index.html.
    "not_found_handling": "404-page"
  }
}
